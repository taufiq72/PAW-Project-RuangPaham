<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
  <div class="max-w-5xl mx-auto p-6">
    <!-- Header -->
    <header class="flex justify-between items-center py-4 border-b border-gray-700 mb-8">
      <h1 class="text-2xl font-bold text-indigo-400">RuangPaham AI</h1>
      <span class="bg-indigo-900 text-indigo-200 text-xs px-3 py-1 rounded-full">v1.0.0 (Week 7)</span>
    </header>

    <!-- Main Content -->
    <main>
      <h2 class="text-xl font-semibold mb-4 text-gray-200">Daftar Dokumen Materi Perkuliahan</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% documents.forEach(doc => { %>
          <div class="bg-gray-800 p-5 rounded-xl border border-gray-700 shadow-lg">
            <h3 class="font-semibold text-lg text-white mb-2"><%= doc.title %></h3>
            <p class="text-sm text-gray-400">Total Halaman: <%= doc.pages %></p>
            <div class="mt-4 flex justify-between items-center">
              <span class="text-xs px-2.5 py-1 rounded <%= doc.status === 'Siap' ? 'bg-green-900 text-green-300' : 'bg-yellow-900 text-yellow-300' %>">
                <%= doc.status %>
              </span>
              <button class="text-xs bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1.5 rounded transition">Pilih Dokumen</button>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </div>
</body>
</html>