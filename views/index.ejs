<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>button:disabled{opacity:.5;cursor:wait}dialog::backdrop{background:#020617cc}input,select{color-scheme:dark}[hidden]{display:none!important}</style>
  <script src="/documents.js" defer></script>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
  <div class="max-w-5xl mx-auto p-6">
    <header class="flex flex-wrap gap-3 justify-between items-center py-4 border-b border-gray-700 mb-8">
      <a href="/" class="text-2xl font-bold text-indigo-400">RuangPaham AI</a>
      <span class="bg-indigo-900 text-indigo-200 text-xs px-3 py-1 rounded-full">Week 10 · Katalog Dokumen</span>
    </header>
    <main>
      <div class="flex flex-wrap justify-between gap-4 items-center mb-6">
        <div><h1 class="text-2xl font-semibold mb-2">Materi perkuliahan</h1><p class="text-gray-400">Kelola judul, jumlah halaman, dan status dokumen belajarmu.</p></div>
        <button id="add-document" class="bg-indigo-600 hover:bg-indigo-500 px-5 py-3 rounded-lg font-medium">+ Tambah Dokumen</button>
      </div>
      <p id="feedback" role="status" aria-live="polite" class="mb-4 text-indigo-200"></p>
      <div class="flex items-center justify-between mb-4"><p id="document-count" class="text-gray-400"><%= documents.length %> dokumen</p><button id="refresh" class="text-indigo-300 underline">Muat ulang</button></div>
      <div id="document-list" class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% documents.forEach(doc => { %>
          <article data-id="<%= doc.id %>" class="bg-gray-800 p-5 rounded-xl border border-gray-700 shadow-lg">
            <h2 class="font-semibold text-lg text-white mb-2 break-words"><%= doc.title %></h2>
            <p class="text-sm text-gray-400">Total Halaman: <%= doc.pages %></p>
            <p class="text-sm text-indigo-300 mt-3"><%= doc.status %></p>
            <div class="flex gap-4 mt-5"><button data-action="detail" class="text-indigo-300 underline">Detail</button><button data-action="edit" class="text-indigo-300 underline">Edit</button><button data-action="delete" class="text-red-300 underline">Hapus</button></div>
          </article>
        <% }) %>
      </div>
      <p id="empty-state" class="p-10 text-center text-gray-400" <%= documents.length ? 'hidden' : '' %>>Belum ada dokumen. Tambahkan materi pertamamu.</p>
      <p class="text-xs text-gray-500 mt-8">Katalog ini menyimpan metadata dokumen. Unggah file dan pemrosesan AI belum tersedia.</p>
    </main>
  </div>
  <dialog id="document-dialog" class="bg-gray-800 text-gray-100 rounded-2xl p-6 w-full max-w-lg border border-gray-600">
    <form id="document-form">
      <h2 id="form-title" class="text-xl font-semibold mb-5">Tambah Dokumen</h2>
      <input type="hidden" id="document-id">
      <label for="title" class="block mb-2">Judul dokumen</label>
      <input id="title" name="title" required maxlength="200" class="w-full bg-gray-900 border border-gray-600 rounded-lg p-3 mb-4" placeholder="Contoh: Modul Basis Data.pdf">
      <label for="pages" class="block mb-2">Jumlah halaman</label>
      <input id="pages" name="pages" type="number" min="1" max="10000" step="1" required class="w-full bg-gray-900 border border-gray-600 rounded-lg p-3 mb-4">
      <label for="status" class="block mb-2">Status</label>
      <select id="status" name="status" class="w-full bg-gray-900 border border-gray-600 rounded-lg p-3 mb-4"><option>Siap</option><option>Diproses</option></select>
      <p id="form-error" role="alert" class="text-red-300 mb-4"></p>
      <div class="flex justify-end gap-3"><button type="button" id="cancel" class="px-4 py-2 border border-gray-500 rounded-lg">Batal</button><button type="submit" id="save" class="px-4 py-2 bg-indigo-600 rounded-lg">Simpan</button></div>
    </form>
  </dialog>
  <dialog id="detail-dialog" class="bg-gray-800 text-gray-100 rounded-2xl p-6 w-full max-w-lg border border-gray-600">
    <h2 class="text-xl font-semibold mb-4">Detail Dokumen</h2><dl id="detail-content" class="space-y-3 break-words"></dl>
    <form method="dialog"><button class="mt-6 px-4 py-2 bg-indigo-600 rounded-lg">Tutup</button></form>
  </dialog>
</body>
</html>
