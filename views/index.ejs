<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'RuangPaham AI' %></title>
    <!-- Tailwind CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">

    <!-- Navbar Header -->
    <nav class="bg-blue-900 text-white shadow-md py-4 px-6">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold">RuangPaham AI</h1>
            <span class="text-xs bg-blue-700 px-3 py-1 rounded font-medium">PPAW Week 10 — Project Berkelanjutan</span>
        </div>
    </nav>

    <!-- Main Content Layout -->
    <main class="container mx-auto px-4 py-6 flex-1 grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Sidebar: Info Dokumen Aktif -->
        <div class="bg-white p-5 rounded-lg shadow-sm border md:col-span-1 h-fit">
            <h2 class="font-bold text-gray-800 text-base mb-3">Dokumen Perkuliahan Aktif</h2>
            <div class="p-3 bg-blue-50 border border-blue-200 rounded-md mb-4">
                <p class="font-semibold text-blue-900 text-sm">Modul_PPAW_Minggu10.pdf</p>
                <span class="text-xs text-green-600 font-semibold">● Status: Siap (RAG Active)</span>
            </div>
            <div class="text-xs text-gray-600 space-y-2">
                <p><strong>Ketentuan AI Assistant:</strong></p>
                <ul class="list-disc pl-4 space-y-1">
                    <li>Jawaban wajib bersumber dari dokumen aktif.</li>
                    <li>Menyertakan rujukan halaman sumber.</li>
                    <li>Menolak secara sopan jika informasi tidak ditemukan dalam dokumen.</li>
                </ul>
            </div>
        </div>

        <!-- Chat Assistant Section -->
        <div class="bg-white rounded-lg shadow-sm border md:col-span-2 flex flex-col h-[550px]">
            <!-- Chat Header -->
            <div class="bg-gray-50 px-4 py-3 border-b font-medium text-gray-700 flex justify-between items-center text-sm">
                <span>Chat Assistant (Google Gemini 1.5 Flash)</span>
                <span class="text-xs text-gray-500">Domain: Dokumen Perkuliahan</span>
            </div>

            <!-- Chat Messages Container -->
            <div id="chat-messages" class="flex-1 p-4 overflow-y-auto space-y-4 bg-gray-50 text-sm">
                <div class="flex justify-start">
                    <div class="bg-white border text-gray-800 p-3 rounded-lg shadow-sm max-w-[85%]">
                        Halo! Silakan ajukan pertanyaan seputar materi di dalam dokumen aktif. AI akan memberikan penjelasan beserta rujukan halamannya.
                    </div>
                </div>
            </div>

            <!-- Loading Indicator -->
            <div id="loading-indicator" class="hidden px-4 py-2 text-gray-500 text-xs italic bg-gray-50 border-t">
                RuangPaham AI sedang mencari informasi dalam dokumen...
            </div>

            <!-- Chat Input Form -->
            <form id="chat-form" class="p-3 bg-white border-t flex gap-2">
                <input type="hidden" id="document-id" value="doc_active_10">
                <input 
                    type="text" 
                    id="user-input" 
                    placeholder="Tanyakan sesuatu dari materi dokumen..." 
                    class="flex-1 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600"
                    autocomplete="off"
                    required
                >
                <button type="submit" class="bg-blue-900 text-white px-5 py-2 rounded-lg text-sm font-medium hover:bg-blue-800 transition">
                    Kirim
                </button>
            </form>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t py-4 text-center text-xs text-gray-500">
        Kelompok 5 — Pengembangan Aplikasi Web (PPAW) Universitas Muhammadiyah Yogyakarta
    </footer>

    <!-- Frontend Script Fetch API -->
    <script>
        const chatForm = document.getElementById('chat-form');
        const userInput = document.getElementById('user-input');
        const chatMessages = document.getElementById('chat-messages');
        const loadingIndicator = document.getElementById('loading-indicator');
        const documentIdInput = document.getElementById('document-id');

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const message = userInput.value.trim();
            const documentId = documentIdInput.value;
            if (!message) return;

            // Tampilkan pesan user
            appendMessage(message, 'user');
            userInput.value = '';
            loadingIndicator.classList.remove('hidden');
            chatMessages.scrollTop = chatMessages.scrollHeight;

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message, documentId })
                });

                const result = await response.json();
                loadingIndicator.classList.add('hidden');

                if (result.success) {
                    appendMessage(result.data.reply, 'ai', result.data.sourceDocument);
                } else {
                    appendMessage(result.message || 'Terjadi kesalahan pada server.', 'ai');
                }
            } catch (error) {
                loadingIndicator.classList.add('hidden');
                appendMessage('Gagal terhubung ke server backend.', 'ai');
            }
            chatMessages.scrollTop = chatMessages.scrollHeight;
        });

        function appendMessage(text, sender, sourceDoc) {
            const div = document.createElement('div');
            div.className = `flex ${sender === 'user' ? 'justify-end' : 'justify-start'}`;
            
            const bubble = document.createElement('div');
            bubble.className = sender === 'user' 
                ? 'bg-blue-900 text-white p-3 rounded-lg max-w-[85%] whitespace-pre-line' 
                : 'bg-white border text-gray-800 p-3 rounded-lg shadow-sm max-w-[85%] whitespace-pre-line';
            
            bubble.textContent = text;

            // Tambahkan badge rujukan halaman jika dari AI dan informasi ditemukan
            if (sender === 'ai' && sourceDoc && !text.includes("Informasi tidak ditemukan")) {
                const badge = document.createElement('div');
                badge.className = 'mt-2 pt-2 border-t text-xs text-blue-600 font-semibold cursor-pointer hover:underline';
                badge.textContent = `📄 Sumber: ${sourceDoc} (Klik untuk verifikasi halaman)`;
                badge.onclick = () => alert(`Membuka rujukan halaman pada dokumen: ${sourceDoc}`);
                bubble.appendChild(badge);
            }

            div.appendChild(bubble);
            chatMessages.appendChild(div);
        }
    </script>
</body>
</html>