{
  "info": {
    "name": "RuangPaham Gemini AI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Daftar dokumen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/chat",
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"Apa saja dokumen yang tersedia?\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON contract\", () => pm.expect(pm.response.json()).to.have.property(\"success\"));"
            ]
          }
        }
      ]
    },
