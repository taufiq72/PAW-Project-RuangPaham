{
  "info": {
    "name": "RuangPaham Week 10 CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "documentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Status database",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Database connected', () => pm.expect(pm.response.json().database).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Semua dokumen",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/dokumen"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Tambah dokumen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/dokumen",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Modul Postman\",\n  \"pages\": 10,\n  \"status\": \"Diproses\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('documentId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Detail dokumen",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/dokumen/{{documentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Edit dokumen",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/dokumen/{{documentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Modul Postman Revisi\",\n  \"pages\": 20,\n  \"status\": \"Siap\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Verifikasi perubahan",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/dokumen/{{documentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Updated data persisted', () => { pm.expect(pm.response.json().data.title).to.eql('Modul Postman Revisi'); pm.expect(pm.response.json().data.pages).to.eql(20); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Hapus dokumen uji",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/dokumen/{{documentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Verifikasi terhapus",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/dokumen/{{documentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Payload invalid",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/dokumen",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"pages\": 0,\n  \"status\": \"Salah\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Alias Week 7",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produk"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}